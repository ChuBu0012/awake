#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
built_cli="$repo_root/build/awake"

if [[ -x "$built_cli" ]]; then
	exec "$built_cli" "$@"
fi

if ! command -v go >/dev/null 2>&1; then
	echo "Awake CLI is not built. Install Go 1.26 or run 'make cli' from the source checkout." >&2
	exit 127
fi

cd "$repo_root"
exec env GOTOOLCHAIN=go1.26.4 MACOSX_DEPLOYMENT_TARGET=12.0 go run ./cmd/awake "$@"
